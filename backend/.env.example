# -----------------------------------------------------------------
# Journeo – Back-end (Express) configuration
# -----------------------------------------------------------------

# Supabase URL – same project URL as the front-end
SUPABASE_URL=

# Service-role secret – KEEP THIS PRIVATE, never expose to the client!
# Copy from Supabase Dashboard > Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Server HTTP port (default 5000)
PORT=5000

# Optional: Google Maps API key for server-side Places lookups
GOOGLE_MAPS_API_KEY=
