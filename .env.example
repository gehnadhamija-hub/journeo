# -----------------------------------------------------------------
# Journeo – Front-end (Vite) configuration
# -----------------------------------------------------------------

# Supabase public endpoint – copy from Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=

# Supabase anon (public) API key – copy from Supabase Dashboard > Settings > API > anon public
VITE_SUPABASE_ANON_KEY=

# URL of the Express back-end (used for AI / itinerary-generation endpoints)
VITE_BACKEND_URL=http://localhost:5000/api

# Optional: Google Maps API key (only needed if you switch to Google Maps)
VITE_GOOGLE_MAPS_API_KEY=

